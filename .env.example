# ─────────────────────────────────────────────────────────────────────────────
# ILLUMINATE — environment variables
# Copy to `.env` (local) or set in your hosting provider. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (server-only, secret) ───────────────────────────────────────────
# PostgreSQL connection strings used by Prisma.
# Local Postgres: set both to the same value.
# Supabase + Vercel:
#   DATABASE_URL = Transaction pooler (port 6543) + "?pgbouncer=true&connection_limit=1"
#   DIRECT_URL   = Session pooler (port 5432) — used only by `prisma migrate`
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/illuminate?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/illuminate?schema=public"

# ── Public URLs ──────────────────────────────────────────────────────────────
# Canonical site URL (used for metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Leave empty when the API is served by this Next.js app (default). Set only if
# the API is hosted on a different origin.
NEXT_PUBLIC_API_BASE_URL=""

# ── Admin sessions (server-only, secret) ─────────────────────────────────────
# At least 32 random characters. Generate with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=""
# Session lifetime in hours (default 12).
ADMIN_SESSION_TTL_HOURS="12"

# ── Payment screenshot storage ───────────────────────────────────────────────
# "supabase" (production) or "local" (development: files under LOCAL_STORAGE_DIR).
STORAGE_PROVIDER="supabase"
LOCAL_STORAGE_DIR="./storage"
# Only set to "true" to run STORAGE_PROVIDER=local under `next start` on a
# single server with a persistent disk. Not suitable for serverless hosting.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION="false"

# Supabase project URL and keys (Project Settings → API).
SUPABASE_URL=""
# Public anon key — not used by the server code today; listed for completeness.
SUPABASE_ANON_KEY=""
# SERVICE ROLE KEY IS A SECRET — server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""
# Private bucket for payment screenshots (must NOT be public).
SUPABASE_STORAGE_BUCKET="payment-screenshots"

# ── Rate limiting / proxies ──────────────────────────────────────────────────
# "true" when running behind a proxy/CDN that sets X-Forwarded-For (Vercel,
# Nginx, Cloudflare). Set "false" if the Node server is exposed directly.
TRUST_PROXY_HEADERS="true"

# ── Organiser details (shown publicly) ───────────────────────────────────────
# Leave empty until confirmed — the site then shows clearly marked placeholders
# (UPI_ID_PLACEHOLDER, CONTACT_EMAIL_PLACEHOLDER, …) instead of fake details.
PAYMENT_UPI_ID=""
PAYMENT_PAYEE_NAME=""
# Public path/URL of the official UPI QR image, e.g. /payment/upi-qr.png (put the file in public/payment/).
PAYMENT_QR_IMAGE_URL=""
CONTACT_EMAIL=""
CONTACT_PHONE=""
